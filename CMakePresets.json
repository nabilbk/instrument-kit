{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "lvgl-headless",
      "displayName": "LVGL widgets + headless PNG renderer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/lvgl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IDEV_BUILD_LVGL": "ON",
        "IDEV_BUILD_QT": "OFF"
      }
    },
    {
      "name": "lvgl-sdl",
      "displayName": "LVGL widgets + SDL2 simulator",
      "inherits": "lvgl-headless",
      "binaryDir": "${sourceDir}/build/lvgl-sdl",
      "cacheVariables": {
        "IDEV_LVGL_SDL": "ON"
      }
    },
    {
      "name": "qt",
      "displayName": "Qt Quick module + demos (Qt 6.8+)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QT_PATH}",
        "IDEV_BUILD_LVGL": "OFF",
        "IDEV_BUILD_QT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "lvgl-headless",
      "configurePreset": "lvgl-headless"
    },
    {
      "name": "lvgl-sdl",
      "configurePreset": "lvgl-sdl"
    },
    {
      "name": "qt",
      "configurePreset": "qt"
    }
  ],
  "testPresets": [
    {
      "name": "lvgl-headless",
      "configurePreset": "lvgl-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt",
      "configurePreset": "qt",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
